<Window x:Class="Laboratornaya1_SafiullinIR_BPI_24_01.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laboratornaya1_SafiullinIR_BPI_24_01"
        mc:Ignorable="d"
        Title="13 вариант" Height="300" Width="500" MinHeight="300" MinWidth="500" MaxHeight="300" MaxWidth="500">
    <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition  MinWidth="150"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
        <Label Content="Число дня" HorizontalAlignment="Center" Grid.Row="0"/>
        <Label Content="Число месяца" HorizontalAlignment="Center" Grid.Row="1"/>
        <Label Content="Год" HorizontalAlignment="Center" Grid.Row="2"/>
        <Label Content="Дата" HorizontalAlignment="Center" Grid.Row="2" Grid.Column="1"/>
        <TextBox x:Name="month"  Grid.Row ="1 " HorizontalAlignment="Center" VerticalAlignment="Center" Height="50" Width="100" Grid.Column ="0"  PreviewTextInput ="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown "/>
        <TextBox x:Name ="year" Grid.Row ="2 " Height="50" Width="100"   PreviewTextInput ="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown "/>
        <Button x:Name="equalMonthandDay" Grid.Row ="0 " Height="50" Width="300"   Grid.Column="1" Content="Проверить на совпадение число дня и число месяца" Click="equalMonthandDay_r"/>
        <Button x:Name="myDateButton" Grid.Row ="1 " Height="50" Width="300"   Grid.Column="1" Content="Увеличить дату на один месяц" Click="myDateA"/>
        <TextBox x:Name ="day"  Grid.Row ="0 " Height="50" Width="100"    PreviewTextInput ="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown " />
        <TextBox x:Name="dateTextBox" Grid.Row="2" VerticalAlignment="Center"  Grid.Column="1" Height="20" Width="100"   PreviewTextInput ="TextBox_PreviewTextInput" PreviewKeyDown="TextBox_PreviewKeyDown " />
        <Button x:Name="ButtonShowDate" VerticalAlignment="Bottom" Grid.Row="2" Grid.Column="1" Height="20" Width="100"  Click="ButtonShowDate_Click"  Content="Показать дату"/>
    </Grid>
</Window>
